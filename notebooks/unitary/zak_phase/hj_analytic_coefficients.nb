          SqrtBox[
           RowBox[{"1", "-", 
            RowBox[{"2", " ", "ad"}]}]], "-", 
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "ad"}]}]], "+", "wr"}], ")"}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          SqrtBox[
           RowBox[{"1", "-", 
            RowBox[{"2", " ", "ad"}]}]], "+", 
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "ad"}]}]], "+", "wr"}], ")"}]}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
