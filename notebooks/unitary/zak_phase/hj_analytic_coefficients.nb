Cell[CellGroupData[{

Cell["6  Operator-level cross-check with Q3", "Section",ExpressionUUID->"120a1da6-6633-4846-8268-75488135dd2d"],

Cell["\<\
Build H_C, H_J as second-quantized operators from the same 8x8 blocks, \
substitute the operator form of T ( b = T . (alpha,beta,...) ), normal-order, \
and extract the same coefficients with Coefficient[..].  They must match \
section 5.\
\>", "Text",ExpressionUUID->"914adba3-3536-4d4c-aefe-508445ca30b8"],

Cell["\<\
Let[Boson, b, qp];
site  = {b[1], b[2], b[3], b[4]};
psiN  = Join[site, Dagger /@ site];                 (* Nambu spinor of the \
site modes *)

toOp[mat_, pref_] := pref Sum[mat[[i, j]] Multiply[Dagger[psiN[[i]]], \
psiN[[j]]], {i, 8}, {j, 8}];
HCop = NormalOrder @ toOp[HC, 1/2];
HJop = NormalOrder @ toOp[HJ, 1/2];

qpN  = Join[{qp[1], qp[2], qp[3], qp[4]}, Dagger /@ {qp[1], qp[2], qp[3], \
qp[4]}];
rule = Thread[psiN -> Tmat . qpN];                  (* b_i , b_i^dag  as \
(alpha,beta,..) combos *)

HJqp = NormalOrder[HJop /. rule] // ExpandAll // Simplify[#, TimeConstraint \
-> 120] &;\
\>", "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"22f1eb2e-404a-493d-a588-fde6b4f92da6"],

Cell[CellGroupData[{

Cell["\<\
opCoeff[m_, n_] := 2 Coefficient[HJqp, Multiply[Dagger[qp[m]], qp[n]]];       \
 (* number  *)
opPair[m_, n_]  := 2 Coefficient[HJqp, Multiply[Dagger[qp[m]], \
Dagger[qp[n]]]];(* pairing *)

Grid[{
  {\"\", \"matrix  (sec 5)\", \"operator (Q3)\"},
  {\"A_J[alpha_k, beta_k]\",   AJqp[[1, 2]], opCoeff[1, 2]},
  {\"B_J[alpha_k, alpha_-k]\", BJqp[[1, 3]], opPair[1, 3]},
  {\"B_J[alpha_k, beta_-k]\",  BJqp[[1, 4]], opPair[1, 4]},
  {\"B_J[beta_k,  beta_-k]\",  BJqp[[2, 4]], opPair[2, 4]}
} /. x_ :> FullSimplify[x], Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->
  "In[176]:=",ExpressionUUID->"82bb987e-50cb-4611-bbb8-d465172db2f1"],

