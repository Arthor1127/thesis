             RowBox[{"gam", " ", "rho"}]}], "]"}]}], "]"}]}], 
        SqrtBox["2"]]},
      {
       FractionBox[
        RowBox[{"Cos", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"ArcTan", "[", 
           RowBox[{
            RowBox[{
             FractionBox["1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", 
                SqrtBox[
                 RowBox[{"1", "-", 
                  RowBox[{"2", " ", "ad"}]}]]}], "+", 
               SqrtBox[
                RowBox[{"1", "+", 
                 RowBox[{"2", " ", "ad"}]}]], "-", "wr"}], ")"}]}], ",", 
            RowBox[{"gam", " ", "rho"}]}], "]"}]}], "]"}], 
        SqrtBox["2"]]},
      {
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "ph"}]], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"ArcTan", "[", 
            RowBox[{
             RowBox[{
              FractionBox["1", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 SqrtBox[
                  RowBox[{"1", "-", 
                   RowBox[{"2", " ", "ad"}]}]]}], "+", 
                SqrtBox[
                 RowBox[{"1", "+", 
                  RowBox[{"2", " ", "ad"}]}]], "-", "wr"}], ")"}]}], ",", 
             RowBox[{"gam", " ", "rho"}]}], "]"}]}], "]"}]}], 
        SqrtBox["2"]]},
      {
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "ph"}]], " ", 
          RowBox[{"Cos", "[", 
