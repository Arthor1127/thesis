Cell["\<\
atPoint[pt_] := {ad -> pt[\"ad\"], ph -> pt[\"ph\"], dJ -> pt[\"dJ\"], gJ -> \
pt[\"gJ\"]};
analyticAJ[pt_] := AJqp /. atPoint[pt];
analyticBJ[pt_] := BJqp /. atPoint[pt];
maxDiff[a_, b_] := Max @ Abs @ Flatten[N[a] - b];\
\>", "Input",
 CellLabel->
  "In[181]:=",ExpressionUUID->"575797c2-bb06-4f91-9818-550afa78a3a9"],

Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[
  Table[With[{pt = reference[[i]]},
     {i,
      Row[{\"k=\", NumberForm[pt[\"k\"], 3], \"  g_c1=\", pt[\"gc1\"], \" \
g_c2=\", pt[\"gc2\"],
           \"  g_J1=\", pt[\"gJ1\"], \" g_J2=\", pt[\"gJ2\"],
           \"  (\", If[pt[\"gc1\"] > pt[\"gc2\"], \"trivial\", \
\"topological\"], \")\"}],
      ScientificForm[maxDiff[analyticAJ[pt], pt[\"AJnum\"]], 2],
      ScientificForm[maxDiff[analyticBJ[pt], pt[\"BJnum\"]], 2]}],
    {i, Length[reference]}],
  {\"#\", \"parameters\", \"max|\[CapitalDelta] \[Tilde]A_J|\", \"max|\
\[CapitalDelta] \[Tilde]B_J|\"}],
 Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->
  "In[185]:=",ExpressionUUID->"19fa0d08-bcf3-4e9d-a128-c7f6c5e85b37"],

