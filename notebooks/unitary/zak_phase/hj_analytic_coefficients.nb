Cell[CellGroupData[{

Cell["\<\
8.2  Lifting to the hybridised chain / resonator photon state\
\>", "Subsection",ExpressionUUID->"244c3230-4a88-4344-8671-69c62c9c4dbe"],

Cell["\<\
alpha_k and beta_k carry the SSH sublattice Bloch spinors  u_alpha = (1, \
e^{-I ph})/Sqrt[2] , u_beta = (1, -e^{-I ph})/Sqrt[2] .  The hybridised state \
is the TLS eigenvector with each amplitude attached to its photon number:  |\
\[Psi]_k\[RightAngleBracket] = I Sin[beta_k/2] |u_alpha\[RightAngleBracket] \
\[TensorProduct] |0\[RightAngleBracket] + Cos[beta_k/2] |u_beta\
\[RightAngleBracket] \[TensorProduct] |1\[RightAngleBracket] .  Basis order  \
(A,0), (B,0), (A,1), (B,1) .\
\>", "Text",ExpressionUUID->"3f1ae1b7-2710-4ac1-bd3b-efc1eab2431e"],

Cell[CellGroupData[{

Cell["\<\
uAlpha = {1, Exp[-I ph]}/Sqrt[2];
uBeta  = {1, -Exp[-I ph]}/Sqrt[2];
(* NB: trailing '+' keeps the two terms on one expression *)
psiK   = I Sin[betaK/2] Flatten@KroneckerProduct[uAlpha, {1, 0}] +
             Cos[betaK/2] Flatten@KroneckerProduct[uBeta, {0, 1}];

Print[\"<psi_k|psi_k>  ->  \",
  Simplify[ComplexExpand[Conjugate[psiK] . psiK, TargetFunctions -> {Re, \
Im}]]];
MatrixForm[psiK]\
\>", "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"1f477537-d82a-4c4f-a364-d1147095f288"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"<psi_k|psi_k>  ->  \"\>", "\[InvisibleSpace]", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {"0", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              SqrtBox[
               RowBox[{"1", "-", 
                RowBox[{"4", " ", 
                 SuperscriptBox["ad", "2"]}]}]], "+", 
              RowBox[{
               SqrtBox[
                RowBox[{"1", "+", 
                 RowBox[{"2", " ", "ad"}]}]], " ", "wr"}]}], ")"}]}], ">", 
           RowBox[{"2", "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["gam", "2"], " ", 
             SuperscriptBox["rho", "2"]}], "+", 
            RowBox[{"2", " ", 
             SqrtBox[
              RowBox[{"1", "-", 
               RowBox[{"2", " ", "ad"}]}]], " ", "wr"}], "+", 
            SuperscriptBox["wr", "2"]}]}]},
         {"1", 
          TagBox["True",
           "PiecewiseDefault",
           AutoDelete->True]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
