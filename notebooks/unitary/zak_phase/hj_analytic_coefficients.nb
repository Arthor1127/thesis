Cell[CellGroupData[{

Cell["3  The transform  T = T_rot . T_sq", "Section",ExpressionUUID->"cba39084-53c7-4fb0-b39e-933090b88b15"],

Cell[CellGroupData[{

Cell["3.1  Phased sublattice rotation", "Subsection",ExpressionUUID->"1bf3aa33-aef8-4b71-b863-4d86ab4d33df"],

Cell["\<\
alpha_k = (e^{-i ph/2} b_{kA} + e^{+i ph/2} b_{kB})/Sqrt[2],   beta_k  = \
(e^{-i ph/2} b_{kA} - e^{+i ph/2} b_{kB})/Sqrt[2];   for -k the phase flips \
(ph -> -ph).  As a passive Nambu transform \[CapitalPsi]_site = T_rot . \
\[CapitalPsi]_alphabeta .\
\>", "Text",ExpressionUUID->"e72e48ea-2f01-4047-abe4-53c4a8ac9b15"],

Cell["\<\
eh = Exp[I ph/2]; ehc = Exp[-I ph/2];
rotPlus  = (1/Sqrt[2]) {{ehc, eh}, {ehc, -eh}};      (* rows = alpha_k , \
beta_k   *)
rotMinus = (1/Sqrt[2]) {{eh, ehc}, {eh, -ehc}};      (* rows = alpha_-k , \
beta_-k *)
rot4  = ArrayFlatten[{{rotPlus, 0}, {0, rotMinus}}];
Trot  = ArrayFlatten[{{Inverse[rot4], 0}, {0, Conjugate[Inverse[rot4]]}}] // \
Simplify;\
\>", "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"a559c2a8-6c79-4968-946a-853776c50d95"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
3.2  Two-mode squeeze on (alpha_k, alpha_-k) and (beta_k, beta_-k)\
\>", "Subsection",ExpressionUUID->"7594041c-9486-4306-93f8-af93a458d753"],

Cell["\<\
z_{k,alpha} = (1/4) Log[1 + 2 ad],   z_{k,beta} = (1/4) Log[1 - 2 ad];   the \
squeeze  gamma_k -> Cosh z gamma_k + Sinh z gamma_-k^dagger  removes the \
pairing left by the rotation.  With  xa = 1 + 2 ad ,  xb = 1 - 2 ad :  Cosh z \
= (x^{1/4} + x^{-1/4})/2 ,  Sinh z = (x^{1/4} - x^{-1/4})/2 .\
\>", "Text",ExpressionUUID->"c87454da-1a6f-4266-9763-4e70757afbf9"],

Cell["\<\
xa = 1 + 2 ad; xb = 1 - 2 ad;
chA = (xa^(1/4) + xa^(-1/4))/2; shA = (xa^(1/4) - xa^(-1/4))/2;
chB = (xb^(1/4) + xb^(-1/4))/2; shB = (xb^(1/4) - xb^(-1/4))/2;
Umat = DiagonalMatrix[{chA, chB, chA, chB}];
Vmat = Normal @ SparseArray[{{1, 3} -> shA, {3, 1} -> shA, {2, 4} -> shB, {4, \
2} -> shB}, {4, 4}];
Tsq  = ArrayFlatten[{{Umat, Vmat}, {Conjugate[Vmat], Conjugate[Umat]}}];

Tmat = Trot . Tsq // Simplify;
tau3 = DiagonalMatrix[Join[ConstantArray[1, 4], ConstantArray[-1, 4]]];\
\>", "Input",
 CellLabel->
  "In[142]:=",ExpressionUUID->"177cd0d7-96dd-4d2e-81a9-a729b25eb151"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3  T is paraunitary", "Subsection",ExpressionUUID->"82c07e6b-c1ef-4cf9-b9a2-41c141290fbc"],

Cell[CellGroupData[{

Cell["\<\
FullSimplify[ConjugateTranspose[Tmat] . tau3 . Tmat - tau3]   (* -> 0 matrix \
*)\
\>", "Input",
 CellLabel->
  "In[151]:=",ExpressionUUID->"9f36aec7-c457-4018-bb1d-0680594c9ebc"],

