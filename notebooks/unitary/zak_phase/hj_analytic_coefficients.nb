Cell["\<\
All entries ~ 1e-15 (double-precision round-off) -> the closed forms \
reproduce the implemented procedure exactly, across generic k, both TRIMs and \
both topological sides.\
\>", "Text",ExpressionUUID->"76d94e17-669f-43b0-a92f-e2c515df2e97"],

Cell[CellGroupData[{

Cell["7.1  Per-coefficient side by side (point 1)", "Subsection",ExpressionUUID->"693d37e0-2140-4331-9430-1914e6a20160"],

Cell[CellGroupData[{

Cell["\<\
pt = reference[[1]];
aA = analyticAJ[pt]; aB = analyticBJ[pt];
Grid[{
  {\"coefficient\", \"analytic (closed form @ point 1)\", \"numeric \
(PeriodicChainSW)\"},
  {\"A_J[\[Alpha]_k,\[Alpha]_k]\", Chop@aA[[1, 1]], Chop@pt[\"AJnum\"][[1, \
1]]},
  {\"A_J[\[Beta]_k,\[Beta]_k]\",  Chop@aA[[2, 2]], Chop@pt[\"AJnum\"][[2, 2]]},
  {\"A_J[\[Alpha]_k,\[Beta]_k]\", Chop@aA[[1, 2]], Chop@pt[\"AJnum\"][[1, 2]]},
  {\"A_J[\[Alpha]_k,\[Alpha]_-k]\", Chop@aA[[1, 3]], Chop@pt[\"AJnum\"][[1, \
3]]},
  {\"B_J[\[Alpha]_k,\[Alpha]_-k]\", Chop@aB[[1, 3]], Chop@pt[\"BJnum\"][[1, \
3]]},
  {\"B_J[\[Alpha]_k,\[Beta]_-k]\",  Chop@aB[[1, 4]], Chop@pt[\"BJnum\"][[1, \
4]]},
  {\"B_J[\[Beta]_k,\[Beta]_-k]\",   Chop@aB[[2, 4]], Chop@pt[\"BJnum\"][[2, \
4]]},
  {\"B_J[\[Alpha]_k,\[Alpha]_k]\",  Chop@aB[[1, 1]], Chop@pt[\"BJnum\"][[1, \
1]]}
}, Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"8da26102-8695-48e7-83db-914a5be24ce6"],

