Cell[CellGroupData[{

Cell["5.1  The individual coefficients (closed form)", "Subsection",ExpressionUUID->"a0fb8d33-d659-43f2-afe3-0685344ed317"],

Cell["\<\
\[Tilde]A_J is momentum-block-diagonal (it flips the band but never k); \
\[Tilde]B_J is momentum-block-anti-diagonal (every pair is a zero-momentum \
alpha_k / *_-k pair).  Step 9b of K_SPACE_CALCULATIONS.md.\
\>", "Text",ExpressionUUID->"6081cf75-00d8-44d3-89a4-3e882f6a5dca"],

Cell[CellGroupData[{

Cell["\<\
coeffs = {
  \"A_J[alpha_k, alpha_k]  (alpha band shift)\"      -> AJqp[[1, 1]],
  \"A_J[beta_k,  beta_k]   (beta band shift)\"       -> AJqp[[2, 2]],
  \"A_J[alpha_k, beta_k]   (interband, same k)\"     -> AJqp[[1, 2]],
  \"A_J[alpha_k, alpha_-k] (should be 0)\"           -> FullSimplify[AJqp[[1, \
3]]],
  \"A_J[alpha_k, beta_-k]  (should be 0)\"           -> FullSimplify[AJqp[[1, \
4]]],
  \"B_J[alpha_k, alpha_-k] (zero-momentum pair)\"    -> BJqp[[1, 3]],
  \"B_J[alpha_k, beta_-k]  (zero-momentum pair)\"    -> BJqp[[1, 4]],
  \"B_J[beta_k,  beta_-k]  (zero-momentum pair)\"    -> BJqp[[2, 4]],
  \"B_J[alpha_k, alpha_k]  (should be 0)\"           -> FullSimplify[BJqp[[1, \
1]]],
  \"B_J[alpha_k, beta_k]   (should be 0)\"           -> FullSimplify[BJqp[[1, \
2]]]};
Grid[List @@@ coeffs, Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"75f6ce7c-f9bc-4e29-bb29-54ded6c9a564"],

