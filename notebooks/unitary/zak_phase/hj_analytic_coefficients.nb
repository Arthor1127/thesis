In[189]:=",ExpressionUUID->"94487569-ba09-483d-aaf7-eb66ffa68e6e"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"HTLS  =  mean I2 + (\[CapitalDelta]/2) sigma_z + gam rho \
sigma_y  ->  \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}],
  SequenceForm[
  "HTLS  =  mean I2 + (\[CapitalDelta]/2) sigma_z + gam rho sigma_y  ->  ", {{
