Cell[CellGroupData[{

Cell["4  Diagonalising H_C", "Section",ExpressionUUID->"1dab4222-246e-4698-9c6a-26bded24ded6"],

Cell["\<\
\[Tilde]H_C = T^dagger H_C T .  In the honest 1/2 convention its diagonal is \
(1/2) Sqrt[1 \[PlusMinus] 2 ad] ; multiply by the Nambu prefactor 2 for \
physical frequencies.\
\>", "Text",ExpressionUUID->"341e0e5c-d0d0-4e00-8eda-bbd67d5e54dd"],

Cell[CellGroupData[{

Cell["\<\
HCd = FullSimplify[ConjugateTranspose[Tmat] . HC . Tmat];
{ MatrixForm[HCd] , FullSimplify[2 Diagonal[HCd][[1 ;; 4]]] }\
\>", "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"fb365ed4-987b-48c7-b07b-0f97eae44287"],

