83004acfb98d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
hVec    = {0, gam rho, deltaTLS/2};                       (* planar \
pseudo-spin, x-component = 0 *)
betaK   = ArcTan[deltaTLS/2, gam rho];                    (* two-argument \
ArcTan = atan2 *)
Rk      = Sqrt[(gam rho)^2 + (deltaTLS/2)^2];             (* |h| *)
cSpinor = {I Sin[betaK/2], Cos[betaK/2]};                 (* lower \
eigenvector of h.sigma *)

eigenResidual = FullSimplify[
  (gam rho PauliMatrix[2] + (deltaTLS/2) PauliMatrix[3]) . cSpinor + Rk \
cSpinor];
Print[\"h.sigma . cSpinor + Rk cSpinor  ->  \", eigenResidual];
Print[\"  numeric spot check  ->  \",
  Chop @ N[eigenResidual /. {ad -> 0.27, gam -> 0.05, rho -> 0.7, wr -> 0.4}]];
Print[\"norm  Conjugate[cSpinor].cSpinor  ->  \", Simplify[Conjugate[cSpinor] \
. cSpinor]];
Print[\"energy of |\[Psi]_k>  =  meanTLS - Rk  =  \", meanTLS - Rk];\
\>", "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"8627b776-4f92-4ab6-8708-243bcbe50ae3"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"h.sigma . cSpinor + Rk cSpinor  ->  \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}],
  SequenceForm["h.sigma . cSpinor + Rk cSpinor  ->  ", {0, 0}],
