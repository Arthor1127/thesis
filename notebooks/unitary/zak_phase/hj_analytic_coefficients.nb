Cell["\<\
Expected:  {Sqrt[1 + 2 ad], Sqrt[1 - 2 ad], Sqrt[1 + 2 ad], Sqrt[1 - 2 ad]}  \
and HCd off-diagonal / pairing entries all zero.\
\>", "Text",ExpressionUUID->"7ca951f2-6c4c-49f5-bb45-48c2a1c2d5b1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5  Transforming H_J  ->  the analytic coefficients", "Section",ExpressionUUID->"6fdaac25-beec-493b-9e83-8a2c573c72ff"],

Cell[CellGroupData[{

Cell["\<\
HJd = ConjugateTranspose[Tmat] . HJ . Tmat // Simplify[#, TimeConstraint -> \
120] &;

AJqp = FullSimplify[2 HJd[[1 ;; 4, 1 ;; 4]], TimeConstraint -> 90];   (* \
physical number block  \[Tilde]A_J *)
BJqp = FullSimplify[2 HJd[[1 ;; 4, 5 ;; 8]], TimeConstraint -> 90];   (* \
physical pairing block \[Tilde]B_J *)

labels = {\"\[Alpha]_k\", \"\[Beta]_k\", \"\[Alpha]_-k\", \"\[Beta]_-k\"};
Grid[Prepend[MapThread[Prepend, {AJqp, labels}], Prepend[labels, \
\"\[Tilde]A_J\"]], Frame -> All]
Grid[Prepend[MapThread[Prepend, {BJqp, labels}], Prepend[labels, \
\"\[Tilde]B_J\"]], Frame -> All]\
\>", "Input",
 CellLabel->
  "In[154]:=",ExpressionUUID->"c934a3b5-b2a7-46cc-aa41-551540e23757"],

